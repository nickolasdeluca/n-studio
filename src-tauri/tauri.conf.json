{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "N Studio",
  "mainBinaryName": "n-studio",
  "identifier": "dev.nstudio.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      { "title": "N Studio", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 560 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Any database, One IDE.",
    "longDescription": "A database IDE for Firebird: SQL editor, object viewers and editors, services, monitoring.",
    "copyright": "MIT License",
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "10.15" }
  }
}
