# Copy this file to scripts/build-release.env (gitignored) and fill in your
# values. build-release.sh sources it when it is there. Variables exported
# before running the script override what is set here.

# Codesign identity: the "Developer ID Application: Name (TEAMID)" string
# from `security find-identity -v -p codesigning`, or its SHA-1 hash.
# Unset, the first "Developer ID Application" identity in the keychain is used.
#SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarization: ONE of the two methods below.

# Method A: an App Store Connect API key (App Store Connect -> Users and
# Access -> Integrations -> Keys). Used when all three are set. The .p8 file
# can be downloaded only once, when the key is created: never commit it.
#APPLE_API_KEY_PATH="/path/to/AuthKey_XXXX.p8"
#APPLE_API_KEY_ID="XXXXXXXXXX"
#APPLE_API_ISSUER_ID="00000000-0000-0000-0000-000000000000"

# Method B: a notarytool keychain profile, stored once with
# `xcrun notarytool store-credentials <name> --key ... --key-id ... --issuer ...`.
#NOTARY_PROFILE="n-studio-notary"

# Where the finished installer is copied.
#DIST_DIR="dist"
